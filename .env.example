# ── Painel na nuvem / VPS (docker compose) ───────────────────────────────────
# ── Cloud / VPS panel (docker compose) ──────────────────────────────────────
# Login do painel. Obrigatório em qualquer servidor acessível pela internet:
# sem os dois o painel fica aberto. O docker-compose.yml recusa subir sem eles.
# Panel login. Required on any internet-accessible server:
# without both credentials, the panel is open. docker-compose.yml refuses to start without them.
PANEL_USER=
PANEL_PASS=
# Transcrição, vídeo e checagem de postura pela OpenRouter (fora do Apple Silicon).
# Transcription, video and communication stance checks via OpenRouter (outside Apple Silicon).
OPENROUTER_API_KEY=

# Copie para .env e ajuste se quiser. Todos têm default — funciona sem .env.
# Copy to .env and adjust as needed. All have defaults — works without .env.

# Pasta onde fica a sessão do WhatsApp (credenciais). Não versionar.
# Directory containing the WhatsApp session (credentials). Do not commit it to version control.
AUTH_DIR=auth

# Pasta raiz onde o conteúdo é gravado, organizado por grupo.
# Root directory where content is stored, organized by group.
DATA_DIR=data

# Arquivo de configuração de grupos (gerado automaticamente na 1ª conexão).
# Group configuration file (generated automatically on the first connection).
GROUPS_CONFIG=groups.config.json

# Nível de log da aplicação: trace | debug | info | warn | error
# Application log level: trace | debug | info | warn | error
LOG_LEVEL=info

# Nível de log interno do Baileys (costuma ser barulhento): warn é um bom default.
# Baileys internal log level (usually noisy): warn is a good default.
BAILEYS_LOG_LEVEL=warn

# Primeiro nome do operador. A revisão do MCP recusa texto que fala dele na
# terceira pessoa ("vou confirmar com o <nome>"), que entrega a automação.
# Sem isto, usa o nome do próprio contato (que no modo remoto pode faltar).
# Operator's first name. MCP review rejects text referring to the operator in the
# third person ("I'll check with <name>"), which gives away the automation.
# If unset, uses the account's own contact name (which may be unavailable in remote mode).
WAC_NOME_OPERADOR=

# Skill de voz que o MCP manda carregar antes de escrever. Vazio = o molde do
# projeto (voz-do-operador). Preencha com o nome da sua versão já extraída, que
# vale em qualquer pasta (skill de usuário, em ~/.claude/skills).
# Voice skill that MCP asks to load before writing. Empty = the project's
# template (voz-do-operador). Set the name of your previously extracted version,
# available in any directory (a user skill in ~/.claude/skills).
WAC_SKILL_VOZ=

# === Sync nuvem→Mac (opcional, só no Mac) ===
# === Cloud→Mac sync (optional, Mac only) ===
# Vazio = desligado (comportamento padrão). Com isto setado, `npm run dev` puxa o
# gap que a nuvem capturou (enquanto o Mac esteve off) antes de subir o coletor, e
# a mídia é baixada da nuvem sob demanda. URL do painel na nuvem (Tailscale no caso
# atual) + Basic Auth do painel (= PANEL_USER/PANEL_PASS setados na nuvem).
# Empty = disabled (default behavior). When set, `npm run dev` pulls the messages
# captured by the cloud while the Mac was off before starting the collector, and
# media is downloaded from the cloud on demand. Cloud panel URL (currently via
# Tailscale) + panel Basic Auth (= PANEL_USER/PANEL_PASS set in the cloud).
WAC_CLOUD_URL=
WAC_CLOUD_USER=
WAC_CLOUD_PASS=
# Escopo: 'local' (default) só os grupos que o Mac já acompanha; 'all' traz tudo
# (a nuvem tem centenas de DMs/grupos da history sync). Paralelismo: default 8.
# Scope: 'local' (default) only syncs groups already followed by the Mac; 'all' fetches everything
# (the cloud has hundreds of DMs/groups from history sync). Concurrency: default 8.
WAC_SYNC_SCOPE=
WAC_SYNC_CONCURRENCY=

# Recado automático de expediente (scripts/expediente-scheduler.ts).
# Automatic business-hours message (scripts/expediente-scheduler.ts).
# Intervalo do tick em ms (default 300000 = 5min). O config fica em data/expediente.json.
# Tick interval in ms (default 300000 = 5min). Configuration is in data/expediente.json.
# WAC_EXPEDIENTE_INTERVALO_MS=300000

# === MCP remoto: aponta o MCP para o painel na nuvem (em vez de disco local). ===
# === Remote MCP: points MCP to the cloud panel (instead of the local disk). ===
# Por padrão o MCP é local (lê o disco desta máquina). Para usar um coletor que roda
# na nuvem (Railway), ligue WAC_MCP_REMOTE=1 e configure os WAC_CLOUD_* abaixo: a URL
# do SEU painel Railway, e em WAC_CLOUD_USER/WAC_CLOUD_PASS as credenciais do Basic Auth
# do painel (as mesmas PANEL_USER/PANEL_PASS já definidas NO container, não aqui).
# Cada pessoa aponta pro seu container. Os dois modos coexistem.
# MCP is local by default (reads this machine's disk). To use a collector running
# in the cloud (Railway), enable WAC_MCP_REMOTE=1 and configure WAC_CLOUD_* below:
# YOUR Railway panel URL, and its Basic Auth credentials in WAC_CLOUD_USER/WAC_CLOUD_PASS
# (the same PANEL_USER/PANEL_PASS already set IN the container, not here).
# Each person points to their own container. Both modes can coexist.
# WAC_MCP_REMOTE=1
# WAC_CLOUD_URL=https://seu-coletor-production-xxxx.up.railway.app
# WAC_CLOUD_USER=seu_usuario_do_painel
# WAC_CLOUD_PASS=sua_senha_do_painel

# === Proxy /api/control (integrações externas via nuvem) ===
# === /api/control proxy (external integrations via the cloud) ===
# Bearer token exigido pela rota /api/control/* do painel (fail closed: sem a
# env, a rota nega tudo). Setar NO container da nuvem (Railway) e nos clientes
# que consomem a API. Gere forte: openssl rand -hex 32
# Bearer token required by the panel's /api/control/* routes (fail closed: without
# the environment variable, all requests are denied). Set it IN the cloud container
# (Railway) and API clients. Generate a strong token: openssl rand -hex 32
# CONTROL_TOKEN=

# ── API pública v1 (docs/api-v1.md) ──────────────────────────────────────────
# ── Public API v1 (docs/api-v1.md) ───────────────────────────────────────────
# Tokens ficam em <data>/api-tokens.json; gere com scripts/api-token.mjs.
# Tokens are stored in <data>/api-tokens.json; generate them with scripts/api-token.mjs.
# Origens liberadas para chamada direta do navegador (vazio = CORS desligado,
# que é o certo quando o consumidor tem backend próprio).
# Allowed origins for direct browser requests (empty = CORS disabled,
# which is appropriate when the consumer has its own backend).
WAC_API_CORS_ORIGINS=
# Teto de requisições por minuto, por token (default 120).
# Maximum requests per minute, per token (default 120).
WAC_API_RATE_LIMIT=120

# Agenda do painel (/agenda) e "Entrar com Google": credencial OAuth do Google do tipo
# "Aplicativo da Web", com URIs de redirecionamento <URL do painel>/api/google/callback
# (Agenda) e <URL do painel>/api/login/google/callback (login).
# Panel calendar (/agenda) and "Sign in with Google": Google OAuth credentials of type
# "Web application", with redirect URIs <panel URL>/api/google/callback
# (Calendar) and <panel URL>/api/login/google/callback (login).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: força a origem pública usada no redirecionamento do Google.
# Optional: overrides the public origin used for the Google redirect.
# PUBLIC_URL=

# Entrar sem senha: e-mails que entram como dono pelo Google ou por código no e-mail
# (vírgula ou espaço entre eles). Vazio = só usuário e senha.
# Passwordless sign-in: email addresses granted owner access via Google or an email code
# (comma- or space-separated). Empty = username and password only.
PANEL_OWNER_EMAILS=
# Código por e-mail (Resend): chave da API e remetente de um domínio verificado lá,
# ex.: "Balcão <acesso@seudominio.com>". Sem os dois, o botão do código não aparece.
# Email code (Resend): API key and sender from a domain verified with Resend,
# e.g. "Balcão <acesso@seudominio.com>". Without both, the email code button is hidden.
RESEND_API_KEY=
RESEND_FROM=
